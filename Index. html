                        <label class="text-xs text-slate-300 block">Type Text to Translate to Braille:</label>
                        <input type="text" id="braille-input" value="HELLO" maxlength="6" oninput="updateBrailleDisplay()" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-xs font-mono text-white uppercase tracking-widest">
                        <button onclick="speakBrailleText()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-2">
                            <i class="fa-solid fa-volume-high"></i> Speak Text (TTS)
                        </button>
                    </div>
                    <div class="md:col-span-2 glass-card p-4 rounded-xl flex items-center justify-around bg-slate-950 border border-slate-800" id="braille-cell-container">
                        <!-- Dynamic Pins populated via JS -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer Banner -->
    <footer class="border-t border-slate-800/80 bg-slate-950 py-6 text-center text-xs text-slate-500">
        <p>© 2026 Muskan Bhasin (Roll No. 1826055) • BPT-109 Assignment 1</p>
    </footer>

    <script>
        // Tab Router Script
        function switchTab(tabId) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            // Remove active classes from all buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
                btn.classList.add('text-slate-300');
            });

            // Show selected tab content
            const activeContent = document.getElementById('content-' + tabId);
            if (activeContent) activeContent.classList.remove('hidden');

            // Highlight selected tab button
            const activeBtn = document.getElementById('tab-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('active');
                activeBtn.classList.remove('text-slate-300');
            }
        }

        // Q1 Generation Inspector Logic
        const genData = {
            1: { title: "1st Generation (1940-1956)", chip: "Vacuum Tubes / Thermionic Valves", speed: "Milliseconds", storage: "Magnetic Drums", lang: "Machine Code (0s & 1s)", ex: "ENIAC, UNIVAC, EDVAC" },
            2: { title: "2nd Generation (1956-1963)", chip: "Discrete Germanium Transistors", speed: "Microseconds", storage: "Magnetic Core Memory", lang: "Assembly & Early FORTRAN/COBOL", ex: "IBM 7094, CDC 1604" },
            3: { title: "3rd Generation (1964-1971)", chip: "Integrated Circuits (SSI/MSI)", speed: "Nanoseconds", storage: "Magnetic Disk Pack", lang: "High-Level (PASCAL, C, BASIC)", ex: "IBM System/360, PDP-8" },
            4: { title: "4th Generation (1971-Present)", chip: "VLSI / ULSI Microprocessors", speed: "Picoseconds", storage: "NVMe SSD & DDR4/DDR5 RAM", lang: "OOP (C++, Java, Python, Rust)", ex: "Modern PCs, Apple M-Series, Intel i9" },
            5: { title: "5th Generation (Present & Future)", chip: "ULSI, AI Neural Processing Units (NPUs) & Quantum Qubits", speed: "ExaFLOPS & Parallel Supercomputing", storage: "3D NAND & Quantum Registers", lang: "Natural Language & AI Prompts", ex: "Supercomputers, Quantum Processing Units" }
        };

        function inspectGen(num) {
            const d = genData[num];
            document.getElementById('gen-details-box').innerHTML = `
                <div class="flex items-center justify-between mb-2">
                    <h4 class="text-sm font-bold text-amber-300">${d.title}</h4>
                    <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700">${d.chip}</span>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-xs text-slate-300 mt-3">
                    <div><span class="text-slate-500 block text-[10px]">EXECUTION SPEED</span><strong>${d.speed}</strong></div>
                    <div><span class="text-slate-500 block text-[10px]">PRIMARY STORAGE</span><strong>${d.storage}</strong></div>
                    <div><span class="text-slate-500 block text-[10px]">PROGRAMMING</span><strong>${d.lang}</strong></div>
                    <div><span class="text-slate-500 block text-[10px]">KEY COMPUTERS</span><strong>${d.ex}</strong></div>
                </div>
            `;
        }
        inspectGen(1);

        // Q2 Bus Simulation Logic
        function runBusSim() {
            const mode = document.getElementById('bus-sim-mode').value;
            const box = document.getElementById('bus-sim-output');
            
            if (mode === 'fetch') {
                box.innerHTML = `<div class="text-cyan-400 font-bold text-xs mb-1"><i class="fa-solid fa-arrow-right-arrow-left mr-1"></i> INSTRUCTION FETCH SIMULATION</div>
                <p class="text-xs text-slate-300">1. CPU Control Unit places RAM address 0x00FF4B on the <strong class="text-blue-400">Address Bus</strong>.<br>2. Control Line triggers <strong class="text-amber-400">READ Signal</strong>.<br>3. RAM returns opcode byte via 64-bit <strong class="text-cyan-400">Data Bus</strong> into CPU Instruction Register.</p>`;
            } else if (mode === 'decode') {
                box.innerHTML = `<div class="text-indigo-400 font-bold text-xs mb-1"><i class="fa-solid fa-microchip mr-1"></i> DECODE & EXECUTE SIMULATION</div>
                <p class="text-xs text-slate-300">1. Instruction Decoder breaks down opcode into ALU operation ADD [R1, R2].<br>2. ALU receives operands and calculates sum.<br>3. Zero & Carry flags updated in CPU Status Register.</p>`;
            } else if (mode === 'writeback') {
                box.innerHTML = `<div class="text-emerald-400 font-bold text-xs mb-1"><i class="fa-solid fa-database mr-1"></i> MEMORY WRITEBACK SIMULATION</div>
                <p class="text-xs text-slate-300">1. CPU asserts <strong class="text-amber-400">WRITE Signal</strong> on Control Bus.<br>2. Target RAM address placed on Address Bus.<br>3. Calculated result written into Memory cell via Data Bus.</p>`;
            } else if (mode === 'dma') {
                box.innerHTML = `<div class="text-purple-400 font-bold text-xs mb-1"><i class="fa-solid fa-bolt mr-1"></i> DIRECT MEMORY ACCESS (DMA) TRANSFER</div>
                <p class="text-xs text-slate-300">1. I/O Controller requests bus ownership from CPU.<br>2. DMA Controller streams scanner data directly into RAM bypassing CPU cycles.<br>3. Interrupt signal fired upon transfer completion.</p>`;
            }
        }

        // Q3 Campus Terminal Logic
        function simCampusScan(type) {
            const log = document.getElementById('campus-log');
            const time = new Date().toLocaleTimeString();
            let entry = "";
            if (type === 'rfid') {
                entry = `<div class="text-emerald-400">[${time}] RFID TAP: Student Card #1826055 Verified. Attendance Logged -> Classroom 302.</div>`;
            } else if (type === 'barcode') {
                entry = `<div class="text-cyan-400">[${time}] BARCODE SCAN: ISBN 978-0134685991 ("Computer Architecture"). Book Checked Out.</div>`;
            } else if (type === 'omr') {
                entry = `<div class="text-amber-400">[${time}] OMR SHEET: Batch Exam Sheet Scanned. 45 Student Marks Logged to DB.</div>`;
            }
            log.innerHTML = entry + log.innerHTML;
        }

        // Q5 Digitizer Canvas Logic
        let canvas = document.getElementById('digitizer-canvas');
        let ctx = canvas ? canvas.getContext('2d') : null;
        let isDrawing = false;

        if (canvas && ctx) {
            canvas.addEventListener('mousedown', () => isDrawing = true);
            canvas.addEventListener('mouseup', () => { isDrawing = false; ctx.beginPath(); });
            canvas.addEventListener('mousemove', drawTablet);
        }

        function drawTablet(e) {
            if (!isDrawing) return;
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const p = document.getElementById('pressure-slider').value;
            const radius = (p / 8192) * 12 + 1;

            ctx.lineWidth = radius;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#818cf8';

            ctx.lineTo(x, y);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x, y);
        }

        function updateTabletCanvas() {
            const p = document.getElementById('pressure-slider').value;
            const t = document.getElementById('tilt-slider').value;
            document.getElementById('pressure-val').innerText = p;
            document.getElementById('tilt-val').innerText = t + '°';
        }

        function clearTabletCanvas() {
            if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        // Q7 Biometrics Sandbox Logic
        function calcBiometrics() {
            const noise = parseInt(document.getElementById('noise-slider').value);
            const light = parseInt(document.getElementById('light-slider').value);

            document.getElementById('noise-val').innerText = noise + ' dB';
            document.getElementById('light-val').innerText = light < 30 ? 'Low Light / Glare' : 'Optimal Lighting';

            // Voice error scales heavily with dB noise
            let voiceErr = Math.min(99, Math.max(5, Math.floor((noise - 30) * 1.1)));
            // Vision error scales with poor lighting
            let visionErr = Math.min(95, Math.max(8, Math.floor((100 - light) * 0.4)));

            document.getElementById('voice-err').innerText = voiceErr + '%';
            document.getElementById('voice-bar').style.width = voiceErr + '%';

            document.getElementById('vision-err').innerText = visionErr + '%';
            document.getElementById('vision-bar').style.width = visionErr + '%';
        }

        // Q8 Refreshable Braille Logic
        const brailleMap = {
            'A': [1,0,0,0,0,0], 'B': [1,1,0,0,0,0], 'C': [1,0,0,1,0,0], 'D': [1,0,0,1,1,0],
            'E': [1,0,0,0,1,0], 'F': [1,1,0,1,0,0], 'G': [1,1,0,1,1,0], 'H': [1,1,0,0,1,0],
            'I': [0,1,0,1,0,0], 'J': [0,1,0,1,1,0], 'K': [1,0,1,0,0,0], 'L': [1,1,1,0,0,0],
            'M': [1,0,1,1,0,0], 'N': [1,0,1,1,1,0], 'O': [1,0,1,0,1,0], 'P': [1,1,1,1,0,0],
            'Q': [1,1,1,1,1,0], 'R': [1,1,1,0,1,0], 'S': [0,1,1,1,0,0], 'T': [0,1,1,1,1,0],
            'U': [1,0,1,0,0,1], 'V': [1,1,1,0,0,1], 'W': [0,1,0,1,1,1], 'X': [1,0,1,1,0,1],
            'Y': [1,0,1,1,1,1], 'Z': [1,0,1,0,1,1]
        };

        function updateBrailleDisplay() {
            const input = document.getElementById('braille-input').value.toUpperCase();
            const container = document.getElementById('braille-cell-container');
            container.innerHTML = '';

            for (let i = 0; i < Math.min(input.length, 6); i++) {
                const char = input[i];
                const dots = brailleMap[char] || [0,0,0,0,0,0];
                
                let cellHtml = `<div class="flex flex-col items-center"><span class="text-xs font-bold text-slate-400 mb-1">${char}</span><div class="grid grid-cols-2 gap-1.5 bg-slate-900 p-2 rounded-lg border border-slate-700">`;
                dots.forEach(active => {
                    cellHtml += `<div class="w-3 h-3 rounded-full ${active ? 'bg-emerald-400 shadow-md shadow-emerald-500/50 scale-110' : 'bg-slate-800'} transition-all"></div>`;
                });
                cellHtml += `</div></div>`;
                container.innerHTML += cellHtml;
            }
        }
        updateBrailleDisplay();

        function speakBrailleText() {
            const txt = document.getElementById('braille-input').value;
            if ('speechSynthesis' in window && txt) {
                const utterance = new SpeechSynthesisUtterance(txt);
                window.speechSynthesis.speak(utterance);
            }
        }
    </script>
</body>
