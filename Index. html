                <div class="bg-slate-900/90 rounded-xl p-4 border border-slate-800 overflow-x-auto">
                    <svg viewBox="0 0 800 420" class="w-full h-auto min-w-[650px] font-sans">
                        <!-- Background Bus Tracks -->
                        <rect x="50" y="190" width="700" height="12" fill="#334155" rx="6" />
                        <text x="60" y="182" fill="#94a3b8" font-size="10" font-weight="bold">DATA BUS (Bidirectional - 64 Bit)</text>

                        <rect x="50" y="230" width="700" height="12" fill="#1e293b" stroke="#3b82f6" stroke-width="1" rx="6" />
                        <text x="60" y="222" fill="#60a5fa" font-size="10" font-weight="bold">ADDRESS BUS (Unidirectional CPU -> RAM/IO)</text>

                        <rect x="50" y="270" width="700" height="12" fill="#1e293b" stroke="#f59e0b" stroke-width="1" rx="6" />
                        <text x="60" y="262" fill="#fbbf24" font-size="10" font-weight="bold">CONTROL BUS (READ/WRITE, INTERRUPT, CLK)</text>

                        <!-- Central Processing Unit (CPU) Block -->
                        <rect x="50" y="20" width="260" height="130" fill="#0f172a" stroke="#06b6d4" stroke-width="2" rx="12" />
                        <text x="180" y="42" fill="#38bdf8" font-size="13" font-weight="bold" text-anchor="middle">CPU (CENTRAL PROCESSING UNIT)</text>
                        <!-- Inside CPU: ALU and CU -->
                        <rect x="65" y="55" width="105" height="80" fill="#1e293b" stroke="#0284c7" rx="8" />
                        <text x="117" y="78" fill="#e0f2fe" font-size="11" font-weight="bold" text-anchor="middle">A.L.U.</text>
                        <text x="117" y="95" fill="#94a3b8" font-size="9" text-anchor="middle">Arithmetic &amp; Logic</text>

                        <rect x="190" y="55" width="105" height="80" fill="#1e293b" stroke="#d97706" rx="8" />
                        <text x="242" y="78" fill="#fef3c7" font-size="11" font-weight="bold" text-anchor="middle">CONTROL UNIT</text>
                        <text x="242" y="95" fill="#94a3b8" font-size="9" text-anchor="middle">Decoders &amp; Clocks</text>

                        <!-- Primary Memory Block -->
                        <rect x="360" y="20" width="180" height="130" fill="#0f172a" stroke="#3b82f6" stroke-width="2" rx="12" />
                        <text x="450" y="42" fill="#60a5fa" font-size="13" font-weight="bold" text-anchor="middle">PRIMARY MEMORY (RAM)</text>
                        <rect x="380" y="55" width="140" height="35" fill="#1e293b" rx="6" />
                        <text x="450" y="77" fill="#cbd5e1" font-size="10" text-anchor="middle">Instruction Cache (L1/L2)</text>
                        <rect x="380" y="98" width="140" height="35" fill="#1e293b" rx="6" />
                        <text x="450" y="120" fill="#cbd5e1" font-size="10" text-anchor="middle">Data RAM Storage</text>

                        <!-- I/O Interface Block -->
                        <rect x="590" y="20" width="160" height="130" fill="#0f172a" stroke="#10b981" stroke-width="2" rx="12" />
                        <text x="670" y="42" fill="#34d399" font-size="13" font-weight="bold" text-anchor="middle">I/O INTERFACE</text>
                        <rect x="605" y="55" width="130" height="35" fill="#1e293b" rx="6" />
                        <text x="670" y="77" fill="#cbd5e1" font-size="10" text-anchor="middle">Input (KB, Scanner)</text>
                        <rect x="605" y="98" width="130" height="35" fill="#1e293b" rx="6" />
                        <text x="670" y="120" fill="#cbd5e1" font-size="10" text-anchor="middle">Output (Monitor, LFP)</text>

                        <!-- Connecting Vertical Bus Lines -->
                        <!-- CPU Connections -->
                        <line x1="117" y1="150" x2="117" y2="190" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4" />
                        <line x1="180" y1="150" x2="180" y2="230" stroke="#60a5fa" stroke-width="2" />
                        <line x1="242" y1="150" x2="242" y2="270" stroke="#fbbf24" stroke-width="2" />

                        <!-- RAM Connections -->
                        <line x1="420" y1="150" x2="420" y2="190" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4" />
                        <line x1="450" y1="150" x2="450" y2="230" stroke="#60a5fa" stroke-width="2" />
                        <line x1="480" y1="150" x2="480" y2="270" stroke="#fbbf24" stroke-width="2" />

                        <!-- I/O Connections -->
                        <line x1="640" y1="150" x2="640" y2="190" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4" />
                        <line x1="670" y1="150" x2="670" y2="230" stroke="#60a5fa" stroke-width="2" />
                        <line x1="700" y1="150" x2="700" y2="270" stroke="#fbbf24" stroke-width="2" />

                        <!-- Explanatory Bottom Labels -->
                        <text x="400" y="325" fill="#94a3b8" font-size="11" text-anchor="middle">Data Bus: Transfers raw data/opcodes between CPU, RAM, and I/O devices.</text>
                        <text x="400" y="345" fill="#94a3b8" font-size="11" text-anchor="middle">Address Bus: Specifies precise RAM memory locations or I/O port addresses.</text>
                        <text x="400" y="365" fill="#94a3b8" font-size="11" text-anchor="middle">Control Bus: Carries READ/WRITE signals, clock synchronizations, and interrupt lines.</text>
                    </svg>
